# HackPortal — environment variables
# Copy to .env.local and fill from your Supabase project (Project Settings → API).
# NEVER commit .env.local. NEVER prefix the service role key with NEXT_PUBLIC.

# Public / safe to expose (anon context). RLS is the real access gate.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Used by the admin client (Route Handlers / seed) and the demo seed.
# Leaking this key = full database access.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
