# HackPortal — environment variables
# Copy to .env.local and fill from your Supabase project (Project Settings → API).
# NEVER commit .env.local. NEVER prefix the service role key with NEXT_PUBLIC.

# Public / safe to expose (anon context). RLS is the real access gate.
# New Supabase key format: the anon key starts with `sb_publishable_`.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# Server-only. Used by the admin client (Route Handlers / seed) and the demo seed.
# New Supabase key format: the service role key starts with `sb_secret_`.
# Leaking this key = full database access. NEVER prefix it with NEXT_PUBLIC.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxx
